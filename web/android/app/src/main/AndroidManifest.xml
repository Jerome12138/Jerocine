<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV 适配: 不要求触屏 / 声明支持 Leanback (required=false 让手机也能装) -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- 手机/平板入口 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV Leanback Launcher 入口 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 原生视频播放器 (ExoPlayer 全屏 + 横屏 + 沉浸式) -->
        <!-- exported=true + ACTION_VIEW: 支持系统文件管理器「打开方式」直接调用本地视频播放 -->
        <activity
            android:name="com.jerocine.player.PlayerActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|navigation"
            android:theme="@style/AppTheme.Player"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- .ts 兜底: 部分文件管理器把 .ts 识别为 application/octet-stream -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.ts" />
            </intent-filter>
        </activity>

        <!-- 下载管理页(公共模块, 从播放器「⋮ 更多→下载管理」与设置页进入) -->
        <activity
            android:name="com.jerocine.player.download.DownloadActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|uiMode|navigation|density"
            android:theme="@style/AppTheme.Download" />

        <!-- 下载前台服务(批量并发下载, 通知实时进度) -->
        <service
            android:name="com.jerocine.player.download.JerocineDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 自升级: 装其他应用 (Android 8.0+ 必需) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 下载前台服务 (Android 8+ 必声明; 14+ 需指定类型) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 下载进度通知 (Android 13+ 运行时权限; 不申请则前台服务通知不展示, 用户看不到进度/续传状态) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
