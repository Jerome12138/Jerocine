<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:controller_layout_id="@layout/exo_player_control_view"
        app:animation_enabled="false"
        app:resize_mode="fit"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- 中央缓冲指示 -->
    <ProgressBar
        android:id="@+id/buffer_spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/gf_accent" />

    <!-- 顶部标题栏 (随控制条一起显隐) — 玻璃渐变 -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/gf_title_scrim"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="22dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gf_text"
            android:textSize="19sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 广告过滤常驻标 (方案B: 当前在走代理过滤时显示) — 玻璃胶囊 + 盾牌图标 -->
        <TextView
            android:id="@+id/ad_filter_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:background="@drawable/gf_badge_bg"
            android:drawableStart="@drawable/ic_shield"
            android:drawablePadding="5dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/gf_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="过滤"
            android:visibility="gone" />

        <!-- 当前片源总集数 (右上角) — 玻璃胶囊 -->
        <TextView
            android:id="@+id/episodes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/gf_badge_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/gf_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/speed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/gf_badge_bg"
            android:textColor="@color/gf_text"
            android:textSize="13sp"
            android:text="1.0×"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />
        <!-- 之前右上有"设置"按钮; 用户要求合并到控制面板右下角默认的设置按钮 (exo_settings),
             Java 层用 setOnClickListener 重写其行为为 showPlayMenu, XML 里就不再放 -->
    </LinearLayout>

    <!-- 中央 播放/暂停 反馈图标 — 无外框, 统一矢量风格(ic_play/ic_pause), 比文字 toast 大 -->
    <ImageView
        android:id="@+id/center_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- 中央 toast 提示 (倍速切换 / seek) — 玻璃浮层 -->
    <TextView
        android:id="@+id/center_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/gf_toast_bg"
        android:paddingHorizontal="22dp"
        android:paddingVertical="16dp"
        android:textColor="@color/gf_text"
        android:textSize="19sp"
        android:gravity="center"
        android:visibility="gone" />
</FrameLayout>
