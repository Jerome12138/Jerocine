<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义 Media3 控件布局: 底部 = 进度行(时间+seekbar) + 其下一排[图标在上+文字在下]按钮.
  按钮(上集/下集/倍速/选集/换源/跳过/退出)id 由 PlayerActivity 绑定点击 + D-pad 焦点 —— id 必须原样保留.
  exo_* id 是 Media3 约定 id(androidx.media3.ui.R.id.*), 控件库自动接管 seekbar/时间.
  风格: 玻璃拟态 —— 底部渐变玻璃面 + 强调青进度条 + 半透明白缓冲/未播.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <!-- 玻璃渐变底栏 (顶部透明 → 底部深玻璃) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/gf_control_scrim"
        android:paddingHorizontal="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">

        <!-- 进度行: 当前时间 — seekbar — 总时长 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gf_text"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                app:played_color="@color/gf_progress_played"
                app:buffered_color="@color/gf_progress_buffered"
                app:unplayed_color="@color/gf_progress_unplayed"
                app:scrubber_color="@color/gf_progress_scrubber"
                app:bar_height="3dp"
                app:scrubber_enabled_size="14dp"
                app:scrubber_dragged_size="18dp"
                app:touch_target_height="26dp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gf_text_secondary"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- 自定义按钮排: 进度条下方, 图标在上 + 文字在下 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_prev"
                style="@style/GfPlayerCtlBtn"
                android:drawableTop="@drawable/ic_prev"
                android:text="上集" />

            <Button
                android:id="@+id/btn_next"
                style="@style/GfPlayerCtlBtn"
                android:drawableTop="@drawable/ic_next"
                android:text="下集" />

            <Button
                android:id="@+id/btn_speed"
                style="@style/GfPlayerCtlBtn"
                android:drawableTop="@drawable/ic_speed"
                android:text="倍速" />

            <Button
                android:id="@+id/btn_episodes"
                style="@style/GfPlayerCtlBtn"
                android:drawableTop="@drawable/ic_episodes"
                android:text="选集" />

            <Button
                android:id="@+id/btn_source"
                style="@style/GfPlayerCtlBtn"
                android:drawableTop="@drawable/ic_source"
                android:text="换源" />

            <Button
                android:id="@+id/btn_skip"
                style="@style/GfPlayerCtlBtn"
                android:drawableTop="@drawable/ic_skip"
                android:text="跳过" />

            <Button
                android:id="@+id/btn_close"
                style="@style/GfPlayerCtlBtn"
                android:drawableTop="@drawable/ic_close"
                android:text="退出" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
