<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 主活动主题 — 与站点根背景同色(@color/jc_bg #0B0B0F), 避免 WebView 加载前白闪
         (用户反馈"启动总有白屏")。windowBackground 同步设成同一色, 保证从 launcher 起就是深色。
         ⚠️ 主题里**不能**写 android:background(2026-10-10 实测坑): 主题级 background 会被
        当成**所有未显式设背景 View 的默认背景** —— 设置抽屉的文字列/面板等全被涂成不透明
         #0B0B0F, 行内文字下面出现一块黑底(用户反馈), 玻璃透明设计整体失效。
         防白闪只靠 windowBackground 就够了。 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/jc_bg</item>
        <item name="android:colorBackground">@color/jc_bg</item>
    </style>

    <!-- Splash 主题 (启动到 onCreate 之间) — 用站点根背景色 #0B0B0F, 之前 @drawable/splash
         是 logo PNG 中心白底, 用户看到的就是白闪.
         配合 MainActivity.onCreate 里的 installSplashScreen(): Android 12+ 走系统 splash
         (背景 + 品牌图标), 首帧(品牌首屏 BrandSplashView, 也是 #0B0B0F)出来即无缝接上 ——
         系统 splash → 品牌首屏 → 页面 三段同为 #0B0B0F, 不再有 #000000/#0B0B0F 的细微跳变。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/jc_bg</item>
        <item name="android:windowBackground">@color/jc_bg</item>
        <item name="android:colorBackground">@color/jc_bg</item>
        <!-- Android 12+ 系统 splash 背景色(不设则跟随主题表面色, 可能非深色) -->
        <item name="windowSplashScreenBackground">@color/jc_bg</item>
        <!-- 系统 splash 图标 = **圆角版** logo(2026-10-10 修订): 之前用 adaptive icon 的
             foreground(ic_launcher_foreground_gradient03) —— 那是满幅方图, 系统 splash
             不做 launcher 的圆角 mask ⇒ 启动先闪一个直角方块再进 BrandSplashView 的
             圆角 logo(用户反馈"方形logo页面"). 换 ic_logo_rounded 后两段同图同底色,
             视觉上是连续的一个首屏。 -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_rounded</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- 原生播放器主题: 全黑 + 隐藏状态栏 / 标题栏 (Activity 本体在 player-core, 主题留在壳里) -->
    <style name="AppTheme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- 下载管理页主题 (2026-10-08): 原先用 AppTheme(Light.DarkActionBar), 页顶挂出一条
         Material 亮色 ActionBar 显示应用名"Jerocine影视", 与整页深色玻璃风格完全脱节
         (问题1 的"Jerocine影视标题"就是它)。改 NoActionBar + 黑底, 页内自有标题栏。
         Activity 里还有 getSupportActionBar().hide() 兜底, 双保险。 -->
    <style name="AppTheme.Download" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!--
      播放器样式(JcPlayerDialog / JcDialogBtn / JcPlayerCtlBtn)由 player-core 提供,
      壳内不再重复定义 —— 重复定义会覆盖库资源, 改了 core 不生效.
    -->
</resources>
