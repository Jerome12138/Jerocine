<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 主活动主题 — 全黑背景, 避免 WebView 加载前白闪 (用户反馈"启动总有白屏"),
         windowBackground 同时设黑色, 保证从 launcher 起就是黑底. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- Splash 主题 (启动到 onCreate 之间) — 用纯黑背景, 之前 @drawable/splash 是
         logo PNG 中心白底, 用户看到的就是白闪. 改成全黑 ColorDrawable. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- 原生播放器主题: 全黑 + 隐藏状态栏 / 标题栏 (Activity 本体在 player-core, 主题留在壳里) -->
    <style name="AppTheme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!--
      播放器样式(JcPlayerDialog / JcPlayerDialogTitle / JcPlayerCtlBtn)由 player-core 提供,
      壳内不再重复定义 —— 重复定义会覆盖库资源, 改了 core 不生效.
    -->
</resources>
