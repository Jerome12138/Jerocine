<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 主活动主题 — 与站点根背景同色(@color/jc_bg #0B0B0F), 避免 WebView 加载前白闪
         (用户反馈"启动总有白屏")。windowBackground 同步设成同一色, 保证从 launcher 起就是深色。
         ⚠️ 主题里**不能**写 android:background(2026-10-10 实测坑): 主题级 background 会被
        当成**所有未显式设背景 View 的默认背景** —— 设置抽屉的文字列/面板等全被涂成不透明
         #0B0B0F, 行内文字下面出现一块黑底(用户反馈), 玻璃透明设计整体失效。
         防白闪只靠 windowBackground 就够了。 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/jc_bg</item>
        <item name="android:colorBackground">@color/jc_bg</item>
    </style>

    <!-- Splash 主题 (启动到 onCreate 之间) — 用站点根背景色 #0B0B0F, 之前 @drawable/splash
         是 logo PNG 中心白底, 用户看到的就是白闪.
         配合 MainActivity.onCreate 里的 installSplashScreen(): 系统 splash 背景同为
         #0B0B0F, 接首帧品牌页(BrandSplashView) 无缝。
         ⚠️ 与 AppTheme.NoActionBar 同理, 主题里**不能**写 android:background —— 本主题
         在 API 31+ 上会**一直**是 Activity 的生效主题(core-splashscreen 的 Impl31 不做
         setTheme, postSplashScreenTheme 形同虚设, 2026-10-10 反编译 1.2.0 实锤), 带着它
         所有编程式 View 又会吃到默认黑背景。
         ⚠️ 系统 splash 图标刻意设为**透明**(2026-10-10): 原本挂 ic_logo_rounded, 但用户
         反馈"logo-only 的系统 splash 与壳内品牌页重复, 去掉前者" —— 透明图标后系统
         splash 就是一帧深色底, 唯一的品牌页只剩 BrandSplashView(logo+文字+loading)。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/jc_bg</item>
        <item name="android:colorBackground">@color/jc_bg</item>
        <!-- Android 12+ 系统 splash 背景色(不设则跟随主题表面色, 可能非深色) -->
        <item name="windowSplashScreenBackground">@color/jc_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!--
      播放器样式(JcPlayerDialog / JcDialogBtn / JcPlayerCtlBtn)由 player-core 提供,
      壳内不再重复定义 —— 重复定义会覆盖库资源, 改了 core 不生效.
      播放器/下载页主题(Theme.JcPlayer / Theme.JcDownload)也已下沉 player-core,
      2026-10-11 起两壳统一引用, 不再各定义一份.
    -->
</resources>
