<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 主活动主题 — 全黑背景, 避免 WebView 加载前白闪 (用户反馈"启动总有白屏"),
         windowBackground 同时设黑色, 保证从 launcher 起就是黑底. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- Splash 主题 (启动到 onCreate 之间) — 用纯黑背景, 之前 @drawable/splash 是
         logo PNG 中心白底, 用户看到的就是白闪. 改成全黑 ColorDrawable. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- 原生播放器主题: 全黑 + 隐藏状态栏 / 标题栏 -->
    <style name="AppTheme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- 播放器弹窗主题: 暗色玻璃 + 品牌青强调色(替代系统亮色 Material Dialog) -->
    <style name="GfPlayerDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/gf_dialog_bg</item>
        <item name="colorAccent">@color/gf_accent</item>
        <item name="android:colorAccent">@color/gf_accent</item>
        <item name="android:textColorPrimary">@color/gf_text</item>
        <item name="android:textColorSecondary">@color/gf_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/gf_text</item>
        <item name="android:windowTitleStyle">@style/GfPlayerDialogTitle</item>
    </style>
    <style name="GfPlayerDialogTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/gf_text</item>
        <item name="android:textSize">19sp</item>
    </style>

    <!-- 原生播放器控件按钮: 图标在上(drawableTop)+ 文字在下, 玻璃风背景, D-pad 焦点高亮. -->
    <style name="GfPlayerCtlBtn" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">66dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/gf_ctl_btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/gf_ctl_btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/gf_ctl_btn_bg</item>
    </style>
</resources>