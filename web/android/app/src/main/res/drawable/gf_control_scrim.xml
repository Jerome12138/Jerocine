<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器底部控件栏背景: 顶部透明 → 底部深玻璃 的竖向渐变(玻璃感, 不依赖 RenderEffect) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="@color/gf_glass_deep"
        android:centerColor="#990B0B0F"
        android:endColor="@android:color/transparent" />
</shape>
