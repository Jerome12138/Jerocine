<?xml version="1.0" encoding="utf-8"?>
<!-- 跳过设置 stepper 按钮背景(玻璃风): 默认半透明白玻璃面 + 细描边;
     focused = 亮青实底 + 白描边(强对比, D-pad 焦点明显), pressed = 深青. 圆角 12dp + ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gf_accent_dim">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gf_accent" />
                    <stroke android:width="2dp" android:color="@color/gf_text" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#FF2BB8CC" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/gf_glass_soft" />
                    <stroke android:width="1dp" android:color="@color/gf_stroke" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
