<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器控件按钮背景(玻璃风): 默认全透明、focused/pressed 给半透明青底 + 强调青描边,
     圆角 14dp, 外层 ripple 触摸涟漪. id/事件由 PlayerActivity 绑定, 这里只是样式. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gf_accent_dim">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gf_accent_dim" />
                    <stroke android:width="1.5dp" android:color="@color/gf_accent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gf_accent_press" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/gf_stroke_faint" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
