<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 下载前台服务 (Android 8+ 必声明; 14+ 需指定类型) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 下载进度通知 (Android 13+ 运行时权限; 不申请则前台服务通知不展示, 用户看不到进度/续传状态) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TV：leanback 不强制，手机/平板也能装 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".JerocineTvApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/jerocine_tv_banner"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.JerocineTV">

        <!-- 原生播放器: 公共模块 player-core 的实现(tv 壳不再自带一份播放器副本) -->
        <!-- exported=true + ACTION_VIEW: 支持系统文件管理器「打开方式」直接调用本地视频播放 -->
        <activity
            android:name="com.jerocine.player.PlayerActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|uiMode|navigation|density"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.JerocineTV.Player">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- .ts 兜底: 部分文件管理器把 .ts 识别为 application/octet-stream -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.ts" />
            </intent-filter>
        </activity>

        <!-- 下载管理页(公共模块, 从播放器「⋮ 更多→下载管理」与设置页进入) -->
        <activity
            android:name="com.jerocine.player.download.DownloadActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|uiMode|navigation|density"
            android:theme="@style/Theme.JerocineTV" />

        <!-- 下载前台服务(批量并发下载, 通知实时进度) -->
        <service
            android:name="com.jerocine.player.download.JerocineDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|uiMode|navigation|density"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.JerocineTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
