<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="130dp"
    android:layout_height="206dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/gf_poster_item"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/poster_cover"
        android:layout_width="122dp"
        android:layout_height="163dp"
        android:background="@color/gf_glass_soft"
        android:duplicateParentState="true"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/poster_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/gf_poster_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/poster_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/gf_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
