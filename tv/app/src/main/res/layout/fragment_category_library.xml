<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gf_bg"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/gf_toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gf_page_padding_horizontal">

        <ImageButton
            android:id="@+id/category_library_back"
            style="@style/GfIconButton"
            android:contentDescription="返回"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/category_library_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:includeFontPadding="false"
            android:textColor="@color/gf_text_secondary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/category_library_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:includeFontPadding="false"
            android:textColor="@color/gf_accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/category_library_count"
            style="@style/GfPageSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/category_library_split"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingTop="80dp"
        android:paddingEnd="36dp"
        android:paddingBottom="24dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/category_library_filters"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="2"
            android:background="@drawable/gf_tv_filter_panel"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingVertical="4dp"
            android:scrollbars="none" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="4"
            android:clipChildren="false"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/category_library_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="2dp"
                android:paddingTop="4dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/category_library_pager"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/category_library_previous"
                    style="@style/GfButtonSecondary"
                    android:layout_width="112dp"
                    android:layout_height="48dp"
                    android:text="上一页" />

                <TextView
                    android:id="@+id/category_library_page"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/gf_text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/category_library_next"
                    style="@style/GfButtonSecondary"
                    android:layout_width="112dp"
                    android:layout_height="48dp"
                    android:text="下一页" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/category_library_progress"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/gf_accent" />

    <LinearLayout
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/category_library_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/gf_text_secondary"
            android:textSize="20sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/category_library_retry"
            style="@style/GfButtonSecondary"
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="重试"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
