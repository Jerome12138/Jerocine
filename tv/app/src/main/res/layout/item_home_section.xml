<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="horizontal"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/home_panel_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/jc_tv_panel_cyan"
        android:clipChildren="false"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_panel_left_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/jc_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_panel_left_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/jc_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/home_panel_left_more"
                style="@style/JcChip"
                android:background="@drawable/jc_tv_more"
                android:layout_width="82dp"
                android:layout_height="38dp"
                android:text="更多"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_panel_left_posters"
            android:layout_width="match_parent"
            android:layout_height="226dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:scrollbars="none" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_panel_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/jc_tv_panel_amber"
        android:clipChildren="false"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_panel_right_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/jc_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_panel_right_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/jc_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/home_panel_right_more"
                style="@style/JcChip"
                android:background="@drawable/jc_tv_more"
                android:layout_width="82dp"
                android:layout_height="38dp"
                android:text="更多"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_panel_right_posters"
            android:layout_width="match_parent"
            android:layout_height="226dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:scrollbars="none" />
    </LinearLayout>
</LinearLayout>
