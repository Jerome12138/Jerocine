<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gf_bg"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/detail_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.18"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60C0D10" />

    <ScrollView
        android:id="@+id/detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="42dp"
            android:paddingTop="76dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/detail_poster"
                android:layout_width="210dp"
                android:layout_height="302dp"
                android:background="@color/gf_surface_2"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="34dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/gf_text"
                    android:includeFontPadding="false"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/gf_text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/detail_people"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/gf_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/detail_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:textColor="@color/gf_text_secondary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/detail_playback_choices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/gf_surface_panel"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="播放源"
                        android:textColor="@color/gf_text_tertiary"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/detail_source_list"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:clipToPadding="false"
                        android:scrollbars="none" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/detail_segment_list"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:clipToPadding="false"
                        android:scrollbars="none"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/detail_episode_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="选集"
                        android:textColor="@color/gf_text_tertiary"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/detail_episode_list"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:scrollbars="none" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <Button
                        android:id="@+id/detail_play"
                        style="@style/GfButtonPrimary"
                        android:layout_width="180dp"
                        android:layout_height="56dp"
                        android:focusable="true"
                        android:text="播放"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/detail_favorite"
                        style="@style/GfButtonSecondary"
                        android:layout_width="150dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="14dp"
                        android:focusable="true"
                        android:text="收藏"
                        android:textAllCaps="false" />

                    <ProgressBar
                        android:id="@+id/detail_play_progress"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="16dp"
                        android:indeterminateTint="@color/gf_accent"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/detail_play_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/gf_danger"
                    android:textSize="17sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <ImageButton
        android:id="@+id/detail_back"
        style="@style/GfIconButton"
        android:layout_gravity="top|start"
        android:layout_marginStart="36dp"
        android:layout_marginTop="18dp"
        android:contentDescription="返回"
        android:src="@drawable/ic_back" />

    <ProgressBar
        android:id="@+id/detail_progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/gf_accent" />

    <LinearLayout
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detail_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/gf_text_secondary"
            android:textSize="20sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/detail_retry"
            style="@style/GfButtonSecondary"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:focusable="true"
            android:text="重试"
            android:textAllCaps="false"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
