<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="JcPageTitle" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/jc_text</item>
        <item name="android:textSize">@dimen/jc_page_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="JcPageSubtitle" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/jc_text_secondary</item>
        <item name="android:textSize">@dimen/jc_caption_size</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="JcButtonBase" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">@dimen/jc_control_height</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="JcButtonPrimary" parent="JcButtonBase">
        <item name="android:background">@drawable/jc_button_primary</item>
        <item name="android:textColor">@color/jc_primary_btn_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="JcButtonSecondary" parent="JcButtonBase">
        <item name="android:background">@drawable/jc_button_secondary</item>
        <item name="android:textColor">@color/jc_ctl_btn_text</item>
    </style>

    <style name="JcButtonDanger" parent="JcButtonBase">
        <item name="android:background">@drawable/jc_button_danger</item>
        <item name="android:textColor">@color/jc_danger_btn_text</item>
    </style>

    <style name="JcChip" parent="JcButtonBase">
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/jc_chip</item>
        <item name="android:textColor">@color/jc_chip_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="JcIconButton" parent="JcButtonSecondary">
        <item name="android:layout_width">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="HomeQuickCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HomeQuickText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">48dp</item>
    </style>

    <style name="HomeQuickTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/jc_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeQuickSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/jc_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="HomeQuickIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:alpha">0.85</item>
    </style>

    <!--
      播放器样式(JcPlayerDialog / JcPlayerDialogTitle / JcPlayerCtlBtn)由 player-core 提供,
      壳内不再重复定义 —— 重复定义会覆盖库资源, 改了 core 不生效.
    -->
</resources>
