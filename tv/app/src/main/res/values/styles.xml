<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GfPageTitle" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/gf_text</item>
        <item name="android:textSize">@dimen/gf_page_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="GfPageSubtitle" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/gf_text_secondary</item>
        <item name="android:textSize">@dimen/gf_caption_size</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="GfButtonBase" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">@dimen/gf_control_height</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="GfButtonPrimary" parent="GfButtonBase">
        <item name="android:background">@drawable/gf_button_primary</item>
        <item name="android:textColor">@color/gf_primary_btn_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GfButtonSecondary" parent="GfButtonBase">
        <item name="android:background">@drawable/gf_button_secondary</item>
        <item name="android:textColor">@color/gf_ctl_btn_text</item>
    </style>

    <style name="GfButtonDanger" parent="GfButtonBase">
        <item name="android:background">@drawable/gf_button_danger</item>
        <item name="android:textColor">@color/gf_danger_btn_text</item>
    </style>

    <style name="GfChip" parent="GfButtonBase">
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/gf_chip</item>
        <item name="android:textColor">@color/gf_chip_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="GfIconButton" parent="GfButtonSecondary">
        <item name="android:layout_width">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="HomeQuickCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HomeQuickText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">48dp</item>
    </style>

    <style name="HomeQuickTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/gf_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeQuickSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/gf_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="HomeQuickIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:alpha">0.85</item>
    </style>
</resources>
