<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gf_surface_3" />
            <stroke android:width="2dp" android:color="@color/gf_text" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gf_surface_3" />
            <stroke android:width="2dp" android:color="@color/gf_text" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gf_accent_dim" />
            <stroke android:width="1dp" android:color="@color/gf_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gf_surface_2" />
            <stroke android:width="1dp" android:color="@color/gf_stroke_faint" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
