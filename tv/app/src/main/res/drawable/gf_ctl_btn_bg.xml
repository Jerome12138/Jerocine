<?xml version="1.0" encoding="utf-8"?>
<!-- 通用次级按钮背景，兼容旧页面与播放器控件。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gf_accent_dim">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gf_accent_dim" />
                    <stroke android:width="1.5dp" android:color="@color/gf_accent" />
                    <corners android:radius="@dimen/gf_control_radius" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gf_accent_press" />
                    <corners android:radius="@dimen/gf_control_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/gf_surface_2" />
                    <stroke android:width="1dp" android:color="@color/gf_stroke" />
                    <corners android:radius="@dimen/gf_control_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
