<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗单选列表行(换源/选集): 直接 include appcompat 的系统默认单选行
  (select_dialog_singlechoice_material —— 库内公开资源; 框架同名布局是 private 不能用),
  圆点在左、paddingStart=20dp、圆点→文字 drawablePadding=20dp, 与原有弹窗缩进**完全一致**。
  左侧 include 覆盖为 weight=1, 右侧挂可选的灰色小标签(当前集已下载标记,
  文案见 PlayerModes.downloadedSourceTag/downloadedEpisodeTag)。
  include 进来的 CheckedTextView 不是行根, ListView 的 checked 传播够不着 →
  选中态由 PlayerDialogHelper 的 adapter 按当前集下标显式 setChecked
  (弹窗列表存续期内容不变、点击即 dismiss, 静态绘制足够)。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <include
        layout="@layout/select_dialog_singlechoice_material"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/jc_row_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="?attr/dialogPreferredPadding"
        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
        android:textColor="@color/jc_text_secondary" />
</LinearLayout>
