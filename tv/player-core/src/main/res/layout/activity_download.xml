<?xml version="1.0" encoding="utf-8"?>
<!--
  下载管理页(公共播放模块, 两壳共用) — 三个 tab: 选集下载 / 下载中 / 已完成.
  设计: 深色玻璃拟态, 触控(手机/平板) + D-pad 焦点(TV) 双兼容;
  选集按 30 集一组分段(与播放器选集弹窗 EPISODE_SEG 一致), 不做区间勾选.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/download_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jc_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 顶部栏: 返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btn_download_back"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="← 返回"
            android:textColor="@color/jc_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_download_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="下载管理"
            android:textColor="@color/jc_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tab_episodes"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="选集下载"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_active"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="下载中"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_done"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="已完成"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tab_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab1: 选集下载 -->
        <LinearLayout
            android:id="@+id/ll_episodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 源选择(多源时显示) + 分段选择(>30 集时显示), 代码填充 -->
            <HorizontalScrollView
                android:id="@+id/hsv_sources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_sources"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/hsv_segments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_segments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>

            <ListView
                android:id="@+id/lv_episodes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/jc_stroke_faint"
                android:dividerHeight="1px"
                android:choiceMode="multipleChoice" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tv_selected_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已选 0 集"
                    android:textColor="@color/jc_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_start_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="120dp"
                    android:paddingHorizontal="24dp"
                    android:text="开始下载"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab2: 下载中 -->
        <ListView
            android:id="@+id/lv_active"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/jc_stroke_faint"
            android:dividerHeight="1px"
            android:visibility="gone" />

        <!-- Tab3: 已完成 -->
        <ListView
            android:id="@+id/lv_done"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/jc_stroke_faint"
            android:dividerHeight="1px"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
