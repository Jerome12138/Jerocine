<?xml version="1.0" encoding="utf-8"?>
<!--
  下载管理页(公共播放模块, 两壳共用) — 三个 tab: 选集下载 / 下载中 / 已完成.
  设计(2026-10-08 定稿, 参考选集类下载页版式): 文字 Tab + 选中下划线,
  信息行(共N集 / 分段选集▾ / 全选圆圈), 下载横幅(进度+速度+暂停全部),
  大集号列表行, 底部居中主按钮。
  深色玻璃拟态, 触控(手机/平板) + D-pad 焦点(TV) 双兼容;
  选集按 30 集一组分段(与播放器选集弹窗 EPISODE_SEG 一致), 分段用胶囊 chips 行(hsv_segments)。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/download_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jc_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 顶部栏: 返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btn_download_back"
            style="@style/JcDownloadIconBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/download_back"
            android:src="@drawable/ic_back"
            app:tint="@color/jc_download_icon_tint" />

        <TextView
            android:id="@+id/tv_download_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/download_title"
            android:textColor="@color/jc_text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab 行: 文字 Tab + 选中下划线(underline_* 由代码切可见性);
         焦点态(暗青底+青描边)由 jc_download_tab_bg 接管, TV D-pad 必须能看出焦点在哪。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/tab_episodes"
            style="@style/JcDownloadTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_episodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_tab_episodes"
                android:textColor="@color/jc_download_tab_text"
                android:textSize="15sp" />

            <View
                android:id="@+id/underline_episodes"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@color/jc_accent"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_active"
            style="@style/JcDownloadTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_tab_active"
                android:textColor="@color/jc_download_tab_text"
                android:textSize="15sp" />

            <View
                android:id="@+id/underline_active"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@color/jc_accent"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_done"
            style="@style/JcDownloadTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_tab_done"
                android:textColor="@color/jc_download_tab_text"
                android:textSize="15sp" />

            <View
                android:id="@+id/underline_done"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@color/jc_accent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tab_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab1: 选集下载 -->
        <LinearLayout
            android:id="@+id/ll_episodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 源选择(多源时显示), 代码填充 -->
            <HorizontalScrollView
                android:id="@+id/hsv_sources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_sources"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>

            <!-- 选集分段(>30集时显示), 代码填充胶囊 chips(用户拍板: 分段保持胶囊标签形式) -->
            <HorizontalScrollView
                android:id="@+id/hsv_segments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_segments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>

            <!-- 信息行: 共 N 集 | 选集 (a~b) ▾(分段弹窗) | 全选 圆圈 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_total_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_total_fmt"
                    android:textColor="@color/jc_text_tertiary"
                    android:textSize="13sp" />

                <!-- 弹性占位: 把「全选」推到行尾 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/ll_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/jc_download_row_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download_select_all"
                        android:textColor="@color/jc_text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/iv_select_all"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/jc_checkbox_off" />
                </LinearLayout>
            </LinearLayout>

            <!-- 下载横幅: 正在下载 x/y + 速度 + 暂停/继续全部; 有活动任务才显示(代码控制) -->
            <LinearLayout
                android:id="@+id/ll_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/jc_download_banner_bg"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_banner_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jc_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_banner_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginEnd="10dp"
                    android:textColor="@color/jc_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_banner_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/jc_download_chip_text"
                    android:background="@drawable/jc_download_chip_bg"
                    android:focusable="true" />
            </LinearLayout>

            <ListView
                android:id="@+id/lv_episodes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:focusable="false" />

            <!-- 底部居中主按钮: 下载选中 (N); 只在选集 tab 出现 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="12dp">

                <Button
                    android:id="@+id/btn_start_download"
                    style="@style/JcDownloadBtnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="220dp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:text="@string/download_start" />
            </FrameLayout>
        </LinearLayout>

        <!-- Tab2: 下载中 — 独立容器: 切 tab 只切容器的可见性。
             2026-10-08 修"三个 tab UI 叠在一起": 旧实现把 ListView 和空态 TextView
             平铺在本 FrameLayout 里, 而 ListView.setEmptyView 会在数据变化时强行把空态
             置 VISIBLE(无视我们手动 GONE) → 选集 tab 底下透出"下载中"空态文字。
             容器化后 setEmptyView 照常工作, 但容器 GONE 时内部全隐藏, 互不可见。 -->
        <FrameLayout
            android:id="@+id/tab_active_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

            <!-- 三轮1: 应用内已下载总大小(代码刷新); 右侧管理入口(2026-10-10 管理模式)。
                 summary 改 weight=1 常驻: 空文本不占视觉, 但保证"管理"恒靠右。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_active_summary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jc_text_tertiary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/ll_select_all_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/jc_download_row_bg"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download_select_all"
                        android:textColor="@color/jc_text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/iv_select_all_active"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/jc_checkbox_off" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_manage_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:text="@string/download_manage"
                    android:textColor="@color/jc_download_chip_text"
                    android:background="@drawable/jc_download_chip_bg"
                    android:focusable="true" />
            </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/lv_active"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@color/jc_stroke_faint"
                        android:dividerHeight="1px"
                        android:focusable="false" />

                    <!-- 下载中空态: ListView.setEmptyView 接管可见性 -->
                    <TextView
                        android:id="@+id/tv_empty_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/download_empty_active"
                        android:textColor="@color/jc_text_tertiary"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- 批量操作栏(管理模式才显示, 代码控制) -->
                <LinearLayout
                    android:id="@+id/ll_batch_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_batch_pause"
                        style="@style/JcDownloadBtnPrimary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:text="@string/download_batch_pause_fmt"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_batch_delete_active"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:text="@string/download_batch_delete_fmt"
                        android:textColor="@color/jc_danger"
                        android:background="@drawable/jc_download_chip_bg"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Tab3: 已完成 — 同上独立容器 -->
        <FrameLayout
            android:id="@+id/tab_done_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

            <!-- 三轮1: 应用内已下载总大小(代码刷新); 右侧管理入口(2026-10-10 管理模式) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_done_summary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jc_text_tertiary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/ll_select_all_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/jc_download_row_bg"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download_select_all"
                        android:textColor="@color/jc_text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/iv_select_all_done"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/jc_checkbox_off" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_manage_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:text="@string/download_manage"
                    android:textColor="@color/jc_download_chip_text"
                    android:background="@drawable/jc_download_chip_bg"
                    android:focusable="true" />
            </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/lv_done"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@color/jc_stroke_faint"
                        android:dividerHeight="1px"
                        android:focusable="false" />

                    <!-- 已完成空态 -->
                    <TextView
                        android:id="@+id/tv_empty_done"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/download_empty_done"
                        android:textColor="@color/jc_text_tertiary"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- 批量操作栏(管理模式才显示, 代码控制) -->
                <LinearLayout
                    android:id="@+id/ll_batch_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_batch_export"
                        style="@style/JcDownloadBtnPrimary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:text="@string/download_batch_export_fmt"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_batch_delete_done"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:text="@string/download_batch_delete_fmt"
                        android:textColor="@color/jc_danger"
                        android:background="@drawable/jc_download_chip_bg"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
