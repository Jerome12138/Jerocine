<?xml version="1.0" encoding="utf-8"?>
<!--
  下载管理页(公共播放模块, 两壳共用) — 三个 tab: 选集下载 / 下载中 / 已完成.
  设计: 深色玻璃拟态, 触控(手机/平板) + D-pad 焦点(TV) 双兼容;
  选集按 30 集一组分段(与播放器选集弹窗 EPISODE_SEG 一致), 不做区间勾选.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/download_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jc_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 顶部栏: 返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btn_download_back"
            style="@style/JcDownloadIconBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/download_back"
            android:src="@drawable/ic_back"
            app:tint="@color/jc_download_icon_tint" />

        <TextView
            android:id="@+id/tv_download_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/download_title"
            android:textColor="@color/jc_text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab 行: 焦点态(青底青框)与选中态(实色青)由 jc_download_tab_bg 处理,
             代码里的 styleTab() 只切 selected, 不再手工设背景。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tab_episodes"
            style="@style/JcDownloadTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/download_tab_episodes" />

        <TextView
            android:id="@+id/tab_active"
            style="@style/JcDownloadTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:text="@string/download_tab_active" />

        <TextView
            android:id="@+id/tab_done"
            style="@style/JcDownloadTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/download_tab_done" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tab_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab1: 选集下载 -->
        <LinearLayout
            android:id="@+id/ll_episodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 源选择(多源时显示) + 分段选择(>30 集时显示), 代码填充 -->
            <HorizontalScrollView
                android:id="@+id/hsv_sources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_sources"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/hsv_segments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_segments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>

            <ListView
                android:id="@+id/lv_episodes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/jc_stroke_faint"
                android:dividerHeight="1px"
                android:choiceMode="multipleChoice" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tv_selected_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/download_selected_zero"
                    android:textColor="@color/jc_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_start_download"
                    style="@style/JcDownloadBtnPrimary"
                    android:layout_width="wrap_content"
                    android:drawableStart="@drawable/ic_download"
                    android:drawablePadding="4dp"
                    android:text="@string/download_start" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab2: 下载中 -->
        <ListView
            android:id="@+id/lv_active"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/jc_stroke_faint"
            android:dividerHeight="1px"
            android:visibility="gone" />

        <!-- Tab3: 已完成 -->
        <ListView
            android:id="@+id/lv_done"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/jc_stroke_faint"
            android:dividerHeight="1px"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
