<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义 Media3 控件布局(公共播放模块唯一一份, 两壳共用; 壳不再各自复制).
  按钮(上集/下集/选集/换源/倍速/跳过/过滤/中转/退出)id 由 PlayerDialogHelper 绑定点击 + D-pad 焦点 —— id 必须原样保留.
  "倍速" / "跳过" / "中转" / "过滤" 是开关类按钮: 文案恒定不变色, 状态全部由**左上角状态点**表达
  (绿=开 / 灰=关, 见 jc_status_dot_on|off.xml) —— 所以这四个按钮各自套一层 FrameLayout,
  点作为兄弟 View 叠在左上角; 其余按钮保持裸 Button, 不要顺手改结构.
  状态点语义: 倍速(播放倍速 ≠ 1.0 即开) / 跳过(片头/片尾跳过已启用) / 中转(分片走服务器转发)
  / 过滤(端侧广告过滤开启). 点位置统一往内收(marginStart 10dp / marginTop 7dp),
  避免贴住 14dp 圆角边缘.
  exo_* id 是 Media3 约定 id(androidx.media3.ui.R.id.*), 控件库自动接管 seekbar/时间.
  风格: 玻璃拟态 —— 底部渐变玻璃面 + 强调青进度条 + 半透明白缓冲/未播.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <!-- 玻璃渐变底栏 (顶部透明 → 底部深玻璃) -->
    <LinearLayout
        android:id="@+id/player_controls_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/jc_control_scrim"
        android:paddingHorizontal="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">

        <!-- 进度行: 当前时间 — seekbar — 总时长 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/jc_text"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                app:played_color="@color/jc_progress_played"
                app:buffered_color="@color/jc_progress_buffered"
                app:unplayed_color="@color/jc_progress_unplayed"
                app:scrubber_color="@color/jc_progress_scrubber"
                app:bar_height="3dp"
                app:scrubber_enabled_size="14dp"
                app:scrubber_dragged_size="18dp"
                app:touch_target_height="26dp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/jc_text_secondary"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- 全部播放操作保持单行, 适配横屏遥控器.
             顺序(用户指定): 上集 / 下集 / 选集 / 换源 / 倍速 / 跳过 / 过滤 / 中转 / 退出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_prev"
                style="@style/JcPlayerCtlBtn"
                android:drawableTop="@drawable/ic_prev"
                android:text="上集" />

            <Button
                android:id="@+id/btn_next"
                style="@style/JcPlayerCtlBtn"
                android:drawableTop="@drawable/ic_next"
                android:text="下集" />

            <Button
                android:id="@+id/btn_episodes"
                style="@style/JcPlayerCtlBtn"
                android:drawableTop="@drawable/ic_episodes"
                android:text="选集" />

            <Button
                android:id="@+id/btn_source"
                style="@style/JcPlayerCtlBtn"
                android:drawableTop="@drawable/ic_source"
                android:text="换源" />

            <!-- 倍速开关: 播放倍速 ≠ 1.0 时点亮状态点(非 1.0 即算开启), 见 PlayerActivity.renderSpeedDot -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_speed"
                    style="@style/JcPlayerCtlBtn"
                    android:drawableTop="@drawable/ic_speed"
                    android:text="倍速" />

                <View
                    android:id="@+id/dot_speed"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/jc_status_dot_off" />
            </FrameLayout>

            <!-- 跳过开关: 片头/片尾跳过启用时点亮, 见 PlayerActivity.renderSkipDot -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_skip"
                    style="@style/JcPlayerCtlBtn"
                    android:drawableTop="@drawable/ic_skip"
                    android:text="跳片头" />

                <View
                    android:id="@+id/dot_skip"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/jc_status_dot_off" />
            </FrameLayout>

            <!-- 广告过滤开关: 同上, 文案固定"去广告", 状态看左上角状态点(绿=开/灰=关) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_ad_filter"
                    style="@style/JcPlayerCtlBtn"
                    android:drawableTop="@drawable/ic_ad_filter"
                    android:text="去广告" />

                <View
                    android:id="@+id/dot_ad_filter"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/jc_status_dot_off" />
            </FrameLayout>

            <!-- 中转开关: 文案固定"中转"(不再写"切到X", 免得整排按钮文案长度不一),
                 开/关看左上角状态点(绿=开). 默认关(分片直连), 开关态持久化见 PlayerNetworkModeHelper.
                 设置里关闭中转时整组隐藏(见 PlayerActivity.updateRelayButtonVisibility). -->
            <FrameLayout
                android:id="@+id/relay_button_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_network_mode"
                    style="@style/JcPlayerCtlBtn"
                    android:drawableTop="@drawable/ic_network_mode"
                    android:text="中转" />

                <View
                    android:id="@+id/dot_network_mode"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/jc_status_dot_off" />
            </FrameLayout>

            <Button
                android:id="@+id/btn_close"
                style="@style/JcPlayerCtlBtn"
                android:drawableTop="@drawable/ic_close"
                android:text="退出" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
