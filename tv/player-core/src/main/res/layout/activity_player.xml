<?xml version="1.0" encoding="utf-8"?>
<!--
  播放器页面布局(公共播放模块唯一一份, 两壳共用; 壳不再各自复制).
  角标: 广告过滤 / 分辨率 / 集数 均在顶部标题栏, 随控制条一起显隐.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:controller_layout_id="@layout/exo_player_control_view"
        app:animation_enabled="false"
        app:resize_mode="fit"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- 中央缓冲指示 -->
    <ProgressBar
        android:id="@+id/buffer_spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/jc_accent" />

    <!-- 顶部标题栏 (随控制条一起显隐) — 玻璃渐变 -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/jc_title_scrim"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="22dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/jc_text"
            android:textSize="19sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 广告过滤标: 状态圆点 + 五态整句(文案/配色对齐前端 web 播放器, 见 AdFilterStatus).
             圆点色调随状态在 Java 层换 drawable(绿/灰/蓝); 无片源时隐藏, 开关关掉也显示"过滤未开启";
             注意它随控制面板一起显隐(与 web 的常驻不同), 是用户拍板保留的差异, 别顺手改成常驻. -->
        <TextView
            android:id="@+id/ad_filter_badge"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:background="@drawable/jc_badge_bg"
            android:drawableStart="@drawable/jc_badge_dot_ok"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"
            android:textColor="@color/jc_text"
            android:textSize="13sp"
            android:text="过滤未开启"
            android:visibility="gone" />

        <!-- 当前集数 (右上角) — 玻璃胶囊 -->
        <TextView
            android:id="@+id/episodes_count"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/jc_badge_bg"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"
            android:textColor="@color/jc_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 线路标: 直连 / 中转(媒体分片是否走中转) -->
        <TextView
            android:id="@+id/network_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/jc_badge_bg"
            android:drawableStart="@drawable/ic_network_mode"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"
            android:text="直连"
            android:textColor="@color/jc_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speed_text"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/jc_badge_bg"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/jc_text"
            android:textSize="13sp"
            android:text="1.0×"
            android:paddingHorizontal="12dp" />

        <!-- 分辨率标: 播放就绪后按视频实际宽高显示 4K/2K/1080P/720P..., 未就绪隐藏 -->
        <TextView
            android:id="@+id/resolution_badge"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/jc_badge_bg"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/jc_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 中央 播放/暂停 反馈图标 — 无外框, 统一矢量风格(ic_play/ic_pause) -->
    <ImageView
        android:id="@+id/center_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- 中央 toast 提示 (倍速切换 / seek) — 玻璃浮层 -->
    <TextView
        android:id="@+id/center_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/jc_toast_bg"
        android:paddingHorizontal="22dp"
        android:paddingVertical="16dp"
        android:textColor="@color/jc_text"
        android:textSize="19sp"
        android:gravity="center"
        android:visibility="gone" />
</FrameLayout>
