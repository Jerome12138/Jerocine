<?xml version="1.0" encoding="utf-8"?>
<!-- 选中态: 18dp 青色圆环 + 8dp 实心内点(四边内缩 5dp 居中, minSdk 21 不能用 item width/height)。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="18dp" android:height="18dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/jc_accent" />
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/jc_accent" />
        </shape>
    </item>
</layer-list>
