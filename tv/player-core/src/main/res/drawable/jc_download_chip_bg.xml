<?xml version="1.0" encoding="utf-8"?>
<!--
  下载页选集 chip 背景 — 三态(focused / selected / 默认)。
  与 jc_download_tab_bg 同款形态: chip 是 D-pad 可聚焦元素, 焦点态必须可见。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_accent_dim" />
            <stroke android:width="2dp" android:color="@color/jc_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_glass_soft" />
            <stroke android:width="1dp" android:color="@color/jc_stroke_faint" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>