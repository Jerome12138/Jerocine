<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框/浮层背景: **不透明**深色面 + 20dp 大圆角 + 1px 细描边.
     刻意用 jc_glass_solid 而不是 jc_glass: 弹窗叠在视频画面上, 带 alpha 会把亮画面透出来,
     在电视等设备上看起来就是"白底"(壳层曾为此单独维护过一份不透明版, 收敛时丢过一次).
     注: 顶/底控制栏那种衬在 UI 上的浮层才用半透明玻璃(jc_glass). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/jc_glass_solid" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/jc_stroke" />
    <padding android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp" />
</shape>
