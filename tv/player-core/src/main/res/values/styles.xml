<?xml version="1.0" encoding="utf-8"?>
<!--
  公共播放模块的样式. 只放"播放器自己要用"的样式 —— 壳层的 AppTheme / 启动页主题属于各壳,
  不要放到这里(早先由 web 壳复制过来, 已清理: 应用资源会覆盖库资源, 留着只会误导).
-->
<resources>

    <!-- 播放器弹窗主题: 暗色玻璃 + 品牌青强调色(替代系统亮色 Material Dialog).
         parent 必须是 AppCompat 系(播放器用 androidx.appcompat.app.AlertDialog).
         字号层级见下方 JcPlayerDialogTitle / ListItem / ListSecondary 三级定义。 -->
    <style name="JcPlayerDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/jc_dialog_bg</item>
        <item name="colorAccent">@color/jc_accent</item>
        <item name="android:colorAccent">@color/jc_accent</item>
        <item name="android:textColorPrimary">@color/jc_text</item>
        <item name="android:textColorSecondary">@color/jc_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/jc_text</item>
        <item name="android:windowTitleStyle">@style/JcPlayerDialogTitle</item>
        <item name="android:textAppearanceListItem">@style/JcPlayerDialogListItem</item>
        <item name="android:textAppearanceListItemSmall">@style/JcPlayerDialogListItem</item>
        <item name="android:textAppearanceListItemSecondary">@style/JcPlayerDialogListSecondary</item>
    </style>

    <!--
     弹窗标题: 原来 14sp、列表正文 13sp, 只差 1sp 且标题不加粗 → **标题与正文看不出区别**。
     现在建立三级层级(用户拍板「标题文字与列表正文需要做出差异」):
       标题 18sp bold + jc_text主色      ← 最强
       列表项 15sp + jc_text             ← 正文
       次级说明 13sp + jc_text_secondary ← 最弱(用于"已开启 · 弱网时预取"这类补充说明)
     字重也参与层级: 标题 bold, 正文 normal。
-->
    <style name="JcPlayerDialogTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/jc_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 列表项(正文): 15sp, 与标题拉开 3sp + 字重差; 颜色仍用 jc_text 保证可读。 -->
    <style name="JcPlayerDialogListItem" parent="@android:style/TextAppearance.Material">
        <item name="android:textColor">@color/jc_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 次级说明: 13sp + 次级色, 用于弹窗里解释当前状态的补充行。 -->
    <style name="JcPlayerDialogListSecondary" parent="@android:style/TextAppearance.Material">
        <item name="android:textColor">@color/jc_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 原生播放器控件按钮: 图标在上(drawableTop) + 文字在下, 玻璃风背景, D-pad 焦点高亮. -->
    <style name="JcPlayerCtlBtn" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">66dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/jc_ctl_btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/jc_ctl_btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/jc_ctl_btn_bg</item>
    </style>

    <!--
      下载页控件样式 — 只定义在 player-core, **不复用 tv/app 的 JcButton***。
      原因: 下载页是 player-core 里的两壳共用页面, 而 JcButtonBase/JcButtonPrimary
      只存在于 tv/app; 库引用壳的资源会让 web/android 壳编译失败(依赖方向必须壳→库)。
      形态与 tv/app 同款: 48dp 高 / 16sp / 8dp 圆角 / textAllCaps=false。
    -->
    <style name="JcDownloadBtnPrimary" parent="android:Widget.Material.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textColor">@color/jc_download_btn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:drawableTint">@color/jc_download_btn_icon_tint</item>
        <item name="android:background">@drawable/jc_download_btn_primary</item>
    </style>

    <!-- 图标按钮: 见方48dp, 图标居中, 焦点背景走 jc_download_icon_btn_bg。 -->
    <style name="JcDownloadIconBtn" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/jc_download_icon_btn_bg</item>
    </style>

    <!--
      Tab 页签(2026-10-08 重设计): 文字 Tab + 选中下划线版式。
      容器可聚焦(D-pad 焦点态= jc_download_tab_bg 的暗青底+青描边), 选中态由子级表达:
      文字色 jc_download_tab_text(state_selected → jc_accent) + underline_* View(3dp 青条)。
    -->
    <style name="JcDownloadTab" parent="">
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/jc_download_tab_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
