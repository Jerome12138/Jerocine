<?xml version="1.0" encoding="utf-8"?>
<!--
  公共播放模块的样式. 只放"播放器自己要用"的样式 —— 壳层的 AppTheme / 启动页主题属于各壳,
  不要放到这里(早先由 web 壳复制过来, 已清理: 应用资源会覆盖库资源, 留着只会误导).
-->
<resources>

    <!-- 播放器弹窗主题: 暗色玻璃 + 品牌青强调色(替代系统亮色 Material Dialog).
         parent 必须是 AppCompat 系(播放器用 androidx.appcompat.app.AlertDialog). -->
    <style name="JcPlayerDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/jc_dialog_bg</item>
        <item name="colorAccent">@color/jc_accent</item>
        <item name="android:colorAccent">@color/jc_accent</item>
        <item name="android:textColorPrimary">@color/jc_text</item>
        <item name="android:textColorSecondary">@color/jc_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/jc_text</item>
        <item name="android:windowTitleStyle">@style/JcPlayerDialogTitle</item>
    </style>

    <style name="JcPlayerDialogTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/jc_text</item>
        <item name="android:textSize">19sp</item>
    </style>

    <!-- 原生播放器控件按钮: 图标在上(drawableTop) + 文字在下, 玻璃风背景, D-pad 焦点高亮. -->
    <style name="JcPlayerCtlBtn" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">66dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/jc_ctl_btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/jc_ctl_btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/jc_ctl_btn_bg</item>
    </style>
</resources>
