<?xml version="1.0" encoding="utf-8"?>
<!--
  Jerocine 安卓壳 — 极简暗色玻璃拟态(glassmorphism)设计令牌.
  风格: 半透明深色磨砂面 + 细描边(~rgba(255,255,255,0.10~0.14) 1px) + 大圆角 + 低对比 + 克制.
  强调色青 #4AD1E5; 主操作可用紫→青渐变 #7C5CFF→#4AD1E5. 偏"影视/TV app"(Apple TV)氛围.
  说明: Android 颜色为 #AARRGGBB (前两位 = alpha). 这里玻璃面用预乘 alpha 的深色十六进制.
-->
<resources>

    <!-- ===== 背景 ===== -->
    <!-- 应用根背景 / 不透明深色基底 -->
    <color name="jc_bg">#0B0B0F</color>
    <color name="jc_bg_black">#000000</color>

    <!-- ===== 玻璃面 (半透明深色磨砂) ===== -->
    <!-- 主玻璃面 (对话框/抽屉/浮层): 深色 ~80% 不透明 -->
    <color name="jc_glass">#CC15151C</color>
    <!-- 次玻璃面 (略浅/略透, 用于卡片/按钮默认底): ~70% -->
    <color name="jc_glass_soft">#B31E1E28</color>
    <!-- 更深玻璃面 (顶/底栏渐变末端) -->
    <color name="jc_glass_deep">#CC0B0B0F</color>
    <!-- 玻璃面的**实色版**(与 jc_glass 同 RGB 15151C, 去掉 alpha): 专供弹窗背景.
         弹窗永远叠在视频画面上, 带 alpha 会把亮画面透出来 → 观感发白/发脏(旧设备尤其明显),
         所以弹窗底色必须不透明. 顶/底栏等"衬在 UI 之上"的浮层才适合用半透明玻璃. -->
    <color name="jc_glass_solid">#FF15151C</color>
    <!-- 遮罩 (抽屉外侧/弹窗背后压暗) -->
    <color name="jc_scrim">#99000000</color>
    <!-- 标题栏轻渐变末端(顶部) -->
    <color name="jc_scrim_top">#B3000000</color>

    <!-- ===== 描边 ===== -->
    <!-- 主细描边 ~rgba(255,255,255,0.13) -->
    <color name="jc_stroke">#22FFFFFF</color>
    <!-- 更淡描边 -->
    <color name="jc_stroke_faint">#14FFFFFF</color>

    <!-- ===== 文本 ===== -->
    <color name="jc_text">#FFFFFFFF</color>
    <color name="jc_text_secondary">#B3FFFFFF</color>
    <color name="jc_text_tertiary">#80FFFFFF</color>

    <!-- ===== 强调 ===== -->
    <!-- 品牌青 -->
    <color name="jc_accent">#FF4AD1E5</color>
    <!-- 品牌青 半透明 (焦点底/进度缓冲) -->
    <color name="jc_accent_dim">#334AD1E5</color>
    <color name="jc_accent_press">#554AD1E5</color>
    <!-- 品牌紫 (渐变起点) -->
    <color name="jc_purple">#FF7C5CFF</color>
    <color name="jc_purple_press">#FF5848D4</color>
    <!-- 焦点态文字色(衬在亮青实底上) -->
    <color name="jc_on_accent">#00141A</color>

    <!-- ===== 危险 ===== -->
    <color name="jc_danger">#FFFF5B6A</color>

    <!-- ===== 角标状态点 (广告过滤角标) ===== -->
    <!-- 与前端 web 播放器 PlayView.vue 的 .jc-player-adtag::before 逐值一致:
         绿 = 过滤正常/有结果; 灰 = 未开启/无需过滤; 蓝 = 服务端过滤中(数量未知) -->
    <color name="jc_badge_ok">#FF34D399</color>
    <color name="jc_badge_idle">#FF9CA3AF</color>
    <color name="jc_badge_busy">#FF60A5FA</color>

    <!-- ===== 进度条 (DefaultTimeBar) ===== -->
    <!-- 已播 = 强调青; 缓冲 = 半透明白; 未播 = 更淡白; 拖动点 = 强调青 -->
    <color name="jc_progress_played">#FF4AD1E5</color>
    <color name="jc_progress_buffered">#55FFFFFF</color>
    <color name="jc_progress_unplayed">#26FFFFFF</color>
    <color name="jc_progress_scrubber">#FF4AD1E5</color>

    <!-- ===== Material 主题色 (供 AppCompatActivity 使用) ===== -->
    <color name="colorPrimary">#FF7C5CFF</color>
    <color name="colorPrimaryDark">#FF5848D4</color>
    <color name="colorAccent">#FF4AD1E5</color>

</resources>
