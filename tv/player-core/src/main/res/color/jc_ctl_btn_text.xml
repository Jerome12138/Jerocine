<?xml version="1.0" encoding="utf-8"?>
<!-- 控件按钮文字/图标着色: 聚焦/按下 = 强调青, 其余 = 白. (drawableTop 图标 tint 同步)
     注意: 开关类按钮("中转"/"过滤")刻意**不**用 state_selected 变色 —— 状态一律交给
     左上角状态点表达(见 jc_status_dot_on|off.xml), 免得"文字变色 + 点变色"两套语义打架. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/jc_accent" />
    <item android:state_pressed="true" android:color="@color/jc_accent" />
    <item android:color="@color/jc_text" />
</selector>
