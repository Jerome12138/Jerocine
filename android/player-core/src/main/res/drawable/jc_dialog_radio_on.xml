<?xml version="1.0" encoding="utf-8"?>
<!-- 选中态: 16dp 青色圆环 + 8dp 实心内点(四边内缩 4dp 居中, minSdk 21 不能用 item width/height)。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="16dp" android:height="16dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/jc_accent" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/jc_accent" />
        </shape>
    </item>
</layer-list>
