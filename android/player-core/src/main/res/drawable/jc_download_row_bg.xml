<?xml version="1.0" encoding="utf-8"?>
<!--
  下载页列表行背景(focused / pressed / 默认透明)。
  行是普通 LinearLayout(选集行/下载中行/已完成行共用): 默认透明靠列表分隔线区隔,
  焦点/按压时浮起玻璃面 —— TV 遥控器必须能看出焦点在哪一行。
  色值走 player-core 令牌, 与 jc_download_tab_bg/jc_download_chip_bg 同款形态。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_accent_dim" />
            <stroke android:width="2dp" android:color="@color/jc_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_accent_press" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
