<?xml version="1.0" encoding="utf-8"?>
<!--
  下载页 Tab 背景 — 2026-10-08 重设计为"文字 Tab + 下划线"版式:
    · 焦点态(TV D-pad): jc_accent_dim 底 + jc_accent 2dp 描边(与 jc_ctl_btn_bg 同款, 焦点必须可见)
    · 按压态: jc_accent_press
    · 选中态不再铺实色青底 —— 选中改由"文字变青 + 下划线"(layout 里的 underline_* View)表达,
      背景回到透明, 与参考版式一致。
  色值全部走 player-core 自己的令牌; 不能引用壳层资源(依赖方向必须壳→库)。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_accent_dim" />
            <stroke android:width="2dp" android:color="@color/jc_accent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_accent_press" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
