<?xml version="1.0" encoding="utf-8"?>
<!--
  公共播放模块的样式. 只放"播放器自己要用"的样式 —— 壳层的 AppTheme / 启动页主题属于各壳,
  不要放到这里(早先由 web 壳复制过来, 已清理: 应用资源会覆盖库资源, 留着只会误导).
-->
<resources>

    <!-- 播放器弹窗主题: 暗色玻璃 + 品牌青强调色。
         2026-10-09 起弹窗全部走 JcDialog 通用组件(外框自绘 jc_dialog_frame,
         AlertDialog 仅作窗口容器) → 主题只留窗口底色与强调色;
         标题/行/按钮版式 token 见 jc_dialog_frame.xml / jc_dialog_row.xml / JcDialogBtn。 -->
    <style name="JcPlayerDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/jc_dialog_bg</item>
        <item name="colorAccent">@color/jc_accent</item>
        <item name="android:colorAccent">@color/jc_accent</item>
        <item name="android:textColorPrimary">@color/jc_text</item>
        <item name="android:textColorSecondary">@color/jc_text_secondary</item>
    </style>

    <!-- JcDialog 按钮区文字按钮: 15sp(与主文字同档), 焦点/按压底复用 stepper 同款(下载页/跳过面板已验证)。 -->
    <style name="JcDialogBtn" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/jc_step_btn_text</item>
        <item name="android:background">@drawable/jc_step_btn_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 原生播放器控件按钮: 图标在上(drawableTop) + 文字在下, 玻璃风背景, D-pad 焦点高亮. -->
    <style name="JcPlayerCtlBtn" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">66dp</item>
        <item name="android:minHeight">0dp</item>
        <!-- margin/paddingHorizontal 是 API 26+ 的简写 —— 用 start/end 等价替代(API 17+) -->
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/jc_ctl_btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">4dp</item>
        <!-- drawableTint 是 API 23+: 拆到 values-v23/styles.xml(完整样式覆盖), 老平台优雅降级为原色图标 -->
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/jc_ctl_btn_bg</item>
    </style>

    <!--
      下载页控件样式 — 只定义在 player-core, **不复用 tvshell 的 JcButton***。
      原因: 下载页是 player-core 里的两壳共用页面, 而 JcButtonBase/JcButtonPrimary
      只存在于 tvshell; 库引用壳的资源会让 :app 壳编译失败(依赖方向必须壳→库)。
      形态与 tvshell 同款: 48dp 高 / 16sp / 8dp 圆角 / textAllCaps=false。
    -->
    <style name="JcDownloadBtnPrimary" parent="android:Widget.Material.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textColor">@color/jc_download_btn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <!-- drawableTint 拆到 values-v23/styles.xml(完整样式覆盖) -->
        <item name="android:background">@drawable/jc_download_btn_primary</item>
    </style>

    <!-- 图标按钮: 见方48dp, 图标居中, 焦点背景走 jc_download_icon_btn_bg。 -->
    <style name="JcDownloadIconBtn" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/jc_download_icon_btn_bg</item>
    </style>

    <!--
      Tab 页签(2026-10-08 重设计): 文字 Tab + 选中下划线版式。
      容器可聚焦(D-pad 焦点态= jc_download_tab_bg 的暗青底+青描边), 选中态由子级表达:
      文字色 jc_download_tab_text(state_selected → jc_accent) + underline_* View(3dp 青条)。
    -->
    <style name="JcDownloadTab" parent="">
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/jc_download_tab_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!--
      原生播放器 Activity 主题(2026-10-11 从两壳下沉到 player-core):
      全黑 + 隐藏 ActionBar/标题栏 + 全屏。
      parent 必须 AppCompat 系 —— PlayerActivity 继承 AppCompatActivity,
      用 android:Theme.Material.NoActionBar 会抛 "You need to use a Theme.AppCompat theme".
      两壳 manifest 统一引用 @style/Theme.JcPlayer, 不再各定义一份。
    -->
    <style name="Theme.JcPlayer" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!--
      下载管理页 Activity 主题(2026-10-11 从 web 壳下沉到 player-core):
      NoActionBar + 黑底 —— 页内自有标题栏, 避免 Material 亮色 ActionBar 与深色玻璃风格脱节。
      两壳 manifest 统一引用 @style/Theme.JcDownload。
    -->
    <style name="Theme.JcDownload" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>
</resources>
