<?xml version="1.0" encoding="utf-8"?>
<!--
  API 23+ 专属样式覆盖 —— drawableTint 是 android: 的 API 23 属性。
  资源按"最匹配配置整体生效": 这里的完整样式定义在 API 23+ 设备上整体替换 values/ 的同名样式;
  API 21/22 用 values/ 版(无 tint, 图标原色 —— 优雅降级, 不崩)。
  ⚠️ 与 values/styles.xml 的同名样式保持同步(仅多 drawableTint 一行), 改动时两边一起改。
-->
<resources>
    <!-- 原生播放器控件按钮 —— 与 values/styles.xml 的 JcPlayerCtlBtn 同步维护 -->
    <style name="JcPlayerCtlBtn" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">66dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/jc_ctl_btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/jc_ctl_btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/jc_ctl_btn_bg</item>
    </style>

    <!-- 下载页主按钮 —— 与 values/styles.xml 的 JcDownloadBtnPrimary 同步维护 -->
    <style name="JcDownloadBtnPrimary" parent="android:Widget.Material.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textColor">@color/jc_download_btn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:drawableTint">@color/jc_download_btn_icon_tint</item>
        <item name="android:background">@drawable/jc_download_btn_primary</item>
    </style>
</resources>
