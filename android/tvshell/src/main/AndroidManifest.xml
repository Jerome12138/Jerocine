<?xml version="1.0" encoding="utf-8"?>
<!--
  :tvshell library 的 manifest —— 合并后只声明"原生壳自己的 Activity"。
  application 节点不写任何属性(name/label/icon/theme)：这些由宿主 :app 的 manifest 统一提供，
  library 写了会在 manifest merge 时与宿主冲突(application 节点属性合并规则是"后者覆盖前者",
  但 label/icon 各写一份会触发 manifest merger 的 conflict 报错)。
  PlayerActivity / DownloadActivity / FileProvider / 权限都不在此声明 —— 宿主 manifest 声明一次即可,
  library 重复声明会导致 merge 冲突或重复组件。
  阶段 E 已将入口改名为 .NativeShellActivity(原 MainActivity)。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 原生壳入口: 由 EntryRouter 转发, 不对外导出 -->
        <activity
            android:name=".NativeShellActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|uiMode|navigation|density"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.JerocineTV.Launch" />
    </application>

</manifest>
