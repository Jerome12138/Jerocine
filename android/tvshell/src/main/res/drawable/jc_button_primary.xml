<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_surface_3" />
            <corners android:radius="@dimen/jc_control_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_text" />
            <stroke android:width="2dp" android:color="@color/jc_accent" />
            <corners android:radius="@dimen/jc_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_accent" />
            <corners android:radius="@dimen/jc_control_radius" />
        </shape>
    </item>
</selector>
