<?xml version="1.0" encoding="utf-8"?>
<!-- 影片卡片底: 常态透明无外框(用户要求去黑底), 仅聚焦时高亮描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jc_accent_dim" />
            <stroke android:width="2dp" android:color="@color/jc_accent" />
            <corners android:radius="@dimen/jc_panel_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/jc_panel_radius" />
        </shape>
    </item>
</selector>
