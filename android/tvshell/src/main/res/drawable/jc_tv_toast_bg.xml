<?xml version="1.0" encoding="utf-8"?>
<!--
  TV 外壳的中央提示背景(收藏 / 历史空态提示): 不透明实面, 同 jc_tv_dialog_bg 的理由.
  播放器内部的中央提示用 player-core 的玻璃版 @drawable/jc_toast_bg.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/jc_surface_1" />
    <stroke android:width="1dp" android:color="@color/jc_tv_border" />
    <corners android:radius="@dimen/jc_panel_radius" />
</shape>
