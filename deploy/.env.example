# Jerocine 重构栈环境变量。cp .env.example .env 后填生产值。.env 已在 .gitignore。

# ---- MySQL(唯一权威真相) ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=jerocine
MYSQL_USER=jerocine
MYSQL_PASSWORD=change_me_app

# ---- Redis(纯缓存 + 协调态; 新架构下可安全淘汰) ----
REDIS_PASSWORD=change_me_redis
REDIS_MAXMEMORY=512mb

# ---- JWT(RS256, PKCS1 PEM 文件挂载在 ./secrets/) ----
# 生成: openssl genrsa -out secrets/jwt_private.pem 2048
#       openssl rsa -in secrets/jwt_private.pem -pubout -RSAPublicKey_out -out secrets/jwt_public.pem
# ⚠ secrets 目录及 *.pem 必须属 65532:65532(distroless nonroot 才能读) —— 见部署记忆。
JWT_PRIVATE_KEY_FILE=/etc/jerocine/secrets/jwt_private.pem
JWT_PUBLIC_KEY_FILE=/etc/jerocine/secrets/jwt_public.pem
AUTH_TOKEN_TTL_HOURS=168
MAX_DEVICE_LOGIN=5

# ---- 安全 ----
# 清库(/api/v1/manage/spider/reset)二次确认 token, 必填, 设个长随机串
SPIDER_RESET_TOKEN=change_me_long_random
# CORS 白名单(逗号分隔; 空=放行所有 Origin)
CORS_ALLOWED_ORIGINS=

# ---- 采集 ----
MAX_GOROUTINE=32

# ---- 埋点(可选) ----
# 埋点 ingest 的**额外**来源域白名单(逗号分隔, 支持 *.example.com); 后台「站点配置 → 域名」
# 会自动纳入, 这里只补多域名/预览域/测试域。默认 jerocine.art。
TELEMETRY_ALLOWED_HOSTS=jerocine.art

# ---- 可选: TMDB 横图回填(未配 key 则功能关闭; 后台「系统 → 站点配置」配的 key 优先) ----
TMDB_API_KEY=
TMDB_LANG=zh-CN
# 自建反代时才需要(留空 = 官方 API / 官方图床)
TMDB_API_BASE=
TMDB_IMAGE_BASE=

# ---- 网络 ----
# nginx 容器直接监听 443 并终结 TLS(单机单站), 端口在 docker-compose.yml 里硬编码,
# 已无 NGINX_PORT 变量; 证书放 deploy/certs/{fullchain,privkey}.pem。
# 宿主机 :80 留给其他服务(如本机 Harness WebUI 的 caddy), 本站不占用。
# 如需恢复"前置反代 + 容器内 HTTP"模式, 自行在 compose 的 nginx.ports 改回端口映射。
