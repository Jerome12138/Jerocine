# Jerocine 裸机（无 Docker）环境变量。cp bare.env.example bare.env 后填生产值。
# bare.env 属机器敏感文件：chmod 600，勿入库。
# 与 deploy/.env.example 键名刻意保持一致（除标注差异项），便于两种模式间对照迁移。

# ---- 安装根目录（systemd unit / 脚本均按此解析） ----
PREFIX=/opt/jerocine

# ---- MySQL(唯一权威真相) ----
# 差异项: 裸机连接走 127.0.0.1(server.env 由 bare-lib.sh 组装, 无需手写 DSN)
# MYSQL_ROOT_PASSWORD 裸机模式不使用(Ubuntu apt 版 root 走 auth_socket),
# 保留仅为与 deploy/.env.example 键名对齐 + Docker→裸机迁移 dump 时参考。
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=jerocine
MYSQL_USER=jerocine
# ⚠ 密码约束(install.sh 渲染前 fail-fast 校验, 违规直接拒绝执行):
#   勿含 ' ` | & @ : / 与空白字符 ——
#     ' ` 破坏 install.sh 建用户 SQL 内插; | & 破坏 sed 渲染(redis 密码 / nginx PREFIX);
#     @ : / 是 go-sql-driver DSN 保留字(compose 模式同样有此限制); 空白破坏 DSN/env 解析。
MYSQL_PASSWORD=change_me_app

# ---- Redis(纯缓存 + 协调态; 可安全淘汰) ----
# ⚠ 密码同 MYSQL_PASSWORD 约束(尤其勿含 | 与 & —— sed 渲染 redis conf 用 | 作分隔符)
REDIS_PASSWORD=change_me_redis
REDIS_MAXMEMORY=512mb

# ---- JWT(RS256, PEM 文件放在 $PREFIX/secrets/) ----
# 生成: openssl genrsa -out secrets/jwt_private.pem 2048
#       openssl rsa -in secrets/jwt_private.pem -pubout -RSAPublicKey_out -out secrets/jwt_public.pem
# (键路径由 PREFIX 推导, 裸机无 /etc/jerocine 挂载)

# 登录有效期(默认 168h)与单账号设备数(默认 5)已改到后台「系统设置 → 账号与安全」, 不再用 env

# ---- 安全 ----
# 清库(/api/v1/manage/spider/reset)二次确认 token, 必填, 设个长随机串
SPIDER_RESET_TOKEN=change_me_long_random
# CORS 白名单(逗号分隔; 空=放行所有 Origin)
CORS_ALLOWED_ORIGINS=

# ---- 采集 ----
# 采集并发上限已改到后台「系统设置 → 采集性能」, 不再用 env

# ---- 可选: TMDB 横图回填(语言与反代地址; API Key 在后台「系统设置 → TMDB」维护) ----
TMDB_LANG=zh-CN
# 自建反代时才需要(留空 = 官方 API / 官方图床)
TMDB_API_BASE=
TMDB_IMAGE_BASE=

# ---- 弹幕数据服务(danmu-service, Node 壳) ----
# bare 模式 danmu-service 与 server 同机(尚未提供 bare 的 danmu systemd 单元/部署脚本,
# 当前 bare 部署形态不含 danmu-service): 未部署时保持默认 http://127.0.0.1:3611 即可 ——
# Go 网关连不上会静默降级"暂无弹幕"(不阻塞播放), 不会报错。
# 留空则由 config 默认值 http://danmu:3611 生效(该域名仅在 compose 网络内可解析, bare 下别用)。
DANMU_SERVICE_URL=http://127.0.0.1:3611

# ---- 可选: golang-migrate 二进制路径(缺省找 /usr/local/bin/migrate) ----
#MIGRATE_BIN=/usr/local/bin/migrate
